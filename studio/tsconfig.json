{
  "compilerOptions": {
    "target": "ES2022", "module": "Preserve", "moduleResolution": "bundler",
    "jsx": "preserve", "strict": true, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "isolatedModules": true, "lib": ["DOM", "ES2022"]
  },
  "include": ["**/*.ts", "**/*.tsx"], "exclude": ["node_modules", "dist"]
}
